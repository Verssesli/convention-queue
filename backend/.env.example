# Required — set an argon2id hash before deploying
ARTIST_PASSWORD_HASH=

NODE_ENV=production

# Optional
PORT=3000
HOST=0.0.0.0
ACCESS_WINDOW_MINUTES=30
DB_PATH=./data/queue.db
UPLOAD_DIR=./uploads
UPLOAD_BASE_URL=/uploads
FRONTEND_DIR=../frontend

#CORS_ORIGIN=https://yourwebsitehere.com

# Reverse-proxy trust for client IP detection (used by rate limiting).
# 'loopback' trusts a local proxy; set to 'true' only if you fully trust the hop,
# or a specific subnet/IP. Wrong values here will mis-attribute rate limits.
#TRUST_PROXY=loopback

# ── Abuse / growth controls ──
# Max people still waiting (global, NAT-safe hard cap on new joins).
MAX_WAITING_ENTRIES=2000
# Per-IP limit on join/requeue (lenient — survives shared convention NAT).
JOIN_RATE_MAX=30
JOIN_RATE_WINDOW=1 minute
# Per-IP limit on login + ceiling on concurrent argon2 verifies (memory guard).
LOGIN_RATE_MAX=10
LOGIN_RATE_WINDOW=1 minute
MAX_CONCURRENT_VERIFIES=4
# Prune completed/abandoned entries older than N hours, every M minutes.
PRUNE_RETENTION_HOURS=24
PRUNE_INTERVAL_MINUTES=30

# ── Artist session cookie ──
# Defaults are correct for HTTPS behind a reverse proxy. Do NOT use the
# "__Host-artist_session" name unless the site is HTTPS end to end: browsers
# discard __Host- cookies silently, which looks like "correct password, then
# instantly unauthorized" with nothing in the logs.
#ARTIST_COOKIE_NAME=artist_session
#ARTIST_COOKIE_SECURE=true      # set false only for a plain-HTTP host
#ARTIST_COOKIE_SAMESITE=lax
#ARTIST_SESSION_TTL_SECONDS=43200

# ── QR access gate ──
# Attendees can only join by scanning the artist's QR code. The hash is stored in
# the database so restarts don't invalidate already-printed codes.
# Absolute public origin used to build the QR link. Set this if you want the link
# pinned regardless of proxy configuration.
# If unset, the origin is resolved from X-Forwarded-Host / Host, then from the
# origin the artist's browser reports. Note that nginx does NOT forward the
# original host by default — it sends the upstream address — so without
#   proxy_set_header Host $host;
# the header-derived value is 127.0.0.1:<port>. The browser-origin fallback covers
# that case, and the QR page warns loudly if the link is still not public.
#PUBLIC_BASE_URL=https://queue.hyuni.cat
#ACCESS_HASH_LENGTH=10
#ACCESS_TTL_SECONDS=259200      # how long a scanned-in attendee stays authorised (3 days)
#ACCESS_COOKIE_SECURE=true